{
  "$schema": "node_modules/wrangler/config-schema.json",

  // ---- Production: branch `main` -> Worker `creative-hands` -> creativehandsceramics.com
  // Deploy command in Cloudflare: npx wrangler deploy --env=""
  // (the empty --env means "production"; without it Wrangler warns because staging also exists)
  "name": "creative-hands",
  "main": "src/index.js",
  "compatibility_date": "2026-11-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "404-page"
  },
  "kv_namespaces": [
    // id: Storage & Databases -> KV -> your namespace (not a secret).
    { "binding": "EVENTS", "id": "df6ed663ddaf462b9f834d05183acdb9" }
  ],
  "observability": { "enabled": true },

  "env": {
    // ---- Staging: branch `staging` -> Worker `creative-hands-staging`
    // Deploy command in Cloudflare: npx wrangler deploy --env staging
    // Uses its own event storage and its own ADMIN_KEY, so testing never touches the live calendar.
    "staging": {
      "name": "creative-hands-staging",
      "kv_namespaces": [
        { "binding": "EVENTS", "id": "9d24e831bf8e4ae9b6d800cdee49032a" }
      ]
    }
  }

  // ADMIN_KEY is a secret: set it on each Worker in the dashboard
  // (Settings -> Variables and Secrets), never in this file.
}
